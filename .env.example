# Copy to .env and adjust:  cp .env.example .env
# .env is not tracked by git, so `git pull` never overwrites it.

# REQUIRED: host folder with your movies/series. Mounted read-write at /media.
MEDIA_PATH=/mnt/data/media

# User/group that owns the media files (run `id` on the server). The app runs as
# this user, so it can write translated files next to the originals.
PUID=1000
PGID=1000

# Port the app is published on: http://SERVER_IP:8790. Add an IP to listen on one
# interface only, e.g. 192.168.1.10:8790 (LAN only) or 127.0.0.1:8790 (behind a
# reverse proxy on the same host). Plain HTTP: never port-forward it to the internet.
HOST_PORT=8790

# Set to true only when the app is served over HTTPS (reverse proxy).
COOKIE_SECURE=false

# IP(s) of your reverse proxy as seen by the container, so the app trusts
# X-Forwarded-For and login rate limiting sees real client IPs. Never use *.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional, comma-separated extra origins allowed for API calls, e.g.
# https://subs.example.com if your reverse proxy rewrites the Host header.
ALLOWED_ORIGINS=

# Optional bundled LibreTranslate: uncomment to start it with every `docker compose`
# command, and use http://libretranslate:5000 in the setup wizard.
#COMPOSE_PROFILES=libretranslate
# Language models it downloads on first start (fewer = less disk and RAM).
LT_LOAD_ONLY=en,fr,de,es,nl
